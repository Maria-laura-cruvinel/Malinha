<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <ImageView android:id="@+id/commons_photo" android:layout_width="match_parent" android:layout_height="180dp"
            android:background="@drawable/bg_explore_photo" android:clipToOutline="true" android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>
        <TextView android:id="@+id/commons_credit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="32dp" android:textSize="11sp" android:textColor="@color/petrol" android:visibility="gone"/>
        <TextView android:id="@+id/destination_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textColor="@color/petrol" />
        <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textColor="@color/petrol" android:text="@string/discover_season"/>
        <TextView android:id="@+id/destination_season" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textColor="@color/petrol" />
        <TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textColor="@color/petrol" android:text="@string/discover_highlights"/>
        <TextView android:id="@+id/destination_highlights" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textColor="@color/petrol" android:text="@string/discover_highlights_default"/>
        <Button android:id="@+id/destination_places" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/local_explore"/>
        <Button android:id="@+id/destination_holidays" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/country_guide"/>
        <Button android:id="@+id/destination_template" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/ready_destination"/>
    </LinearLayout>
</ScrollView>
