<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingVertical="16dp">
    <TextView android:id="@+id/empty_day" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/empty_day" android:textSize="18sp"/>
    <Button android:id="@+id/add_empty_day_activity" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/add_activity"/>
</LinearLayout>
