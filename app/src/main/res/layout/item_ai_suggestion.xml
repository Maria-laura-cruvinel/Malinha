<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" android:padding="12dp"
    android:background="@drawable/bg_card" android:orientation="vertical">
    <ImageView android:id="@+id/commons_photo" android:layout_width="match_parent" android:layout_height="104dp"
        android:background="@drawable/bg_ai_sheet" android:clipToOutline="true" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/commons_credit" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="36dp" android:gravity="center_vertical" android:textColor="@color/petrol"
        android:textSize="12sp" android:visibility="gone"/>
    <TextView android:id="@+id/ai_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/petrol"/>
    <TextView android:id="@+id/ai_category" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:background="@drawable/bg_ai_category"
        android:textColor="@color/petrol" android:textStyle="bold"/>
    <TextView android:id="@+id/ai_description" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/petrol"/>
    <CheckBox android:id="@+id/ai_select" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:buttonTint="@color/petrol" android:textColor="@color/petrol"
        android:text="@string/ai_select"/>
    <Button android:id="@+id/ai_details" style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/ai_details"/>
</LinearLayout>
