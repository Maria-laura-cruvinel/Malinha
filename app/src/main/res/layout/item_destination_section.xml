<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="16dp">
    <TextView android:id="@+id/section_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginBottom="8dp"
        android:textColor="@color/petrol" android:textSize="22sp" android:textStyle="bold"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/section_cards"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"/>
</LinearLayout>
